set bgColor white
camera ortho
windowsize 960 720
lighting soft
material dull
graphics silhouettes false
hide models
hide #2,6 atoms
cartoon #2,6
color #2,6 #81a58b target c
color #2,6 #81a58b target ab
transparency #2,6 20 target c
hide #3,4 cartoons
style #3,4 stick
size #3,4 stickRadius 0.20
color #3 #26a6a1 target ab
color #4 #3169b3 target ab
volume #1 style mesh step 1 level 0.18087127804756165 color #a0a9ad transparency 0.55 squareMesh true meshLighting false
volume #5 style mesh step 1 level 0.5 color #26a6a1 transparency 0.20
volume #26 style surface step 1 level 0.18087127804756165 color #8e9ca5 transparency 0.15 surfaceSmoothing false
